<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV: leanback is preferred but not required so the same APK installs on a phone/emulator for testing. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

        <queries>
        <!-- Lets pickerAvailable() see whether a real folder picker exists (Android 11+ package visibility). -->
        <intent><action android:name="android.intent.action.OPEN_DOCUMENT_TREE" /></intent>
    </queries>

    <application
        android:name=".RetroBoxApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner_icon"
        android:label="@string/app_name"
        android:extractNativeLibs="true"
        android:largeHeap="false"
        android:theme="@style/Theme.RetroBox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".game.GameActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density"
            android:screenOrientation="landscape" />
    </application>
</manifest>
