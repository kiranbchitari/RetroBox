# Copy to keystore.properties (git-ignored) or run tools/make-release-key.sh, which writes it for you.
# storeFile is relative to this file. Keep the keystore and passwords somewhere safe: every update of the
# installed app must be signed with the same key, or Android refuses it (and uninstalling deletes saves).
storeFile=retrobox-release.jks
storePassword=CHANGE_ME
keyAlias=retrobox
keyPassword=CHANGE_ME
